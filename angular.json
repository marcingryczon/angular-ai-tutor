{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-ai-tutor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        },
        "@schematics/angular:directive": {},
        "@schematics/angular:pipe": {},
        "@schematics/angular:service": {},
        "@schematics/angular:guard": {},
        "@schematics/angular:resolver": {}
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-ai-tutor:build:production"
            },
            "development": {
              "buildTarget": "angular-ai-tutor:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "taskflow": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        },
        "@schematics/angular:class": {},
        "@schematics/angular:directive": {},
        "@schematics/angular:guard": {},
        "@schematics/angular:interceptor": {},
        "@schematics/angular:pipe": {},
        "@schematics/angular:resolver": {},
        "@schematics/angular:service": {}
      },
      "root": "projects/taskflow",
      "sourceRoot": "projects/taskflow/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/taskflow/src/main.ts",
            "tsConfig": "projects/taskflow/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/taskflow/public"
              }
            ],
            "styles": ["projects/taskflow/src/styles.scss"],
            "server": "projects/taskflow/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost"]
            },
            "ssr": {
              "entry": "projects/taskflow/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "400kB",
                  "maximumError": "450kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "taskflow:build:production"
            },
            "development": {
              "buildTarget": "taskflow:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/taskflow/tsconfig.spec.json",
            "buildTarget": "taskflow:build:development",
            "runner": "vitest",
            "coverage": true,
            "coverageInclude": ["projects/taskflow/src/app/**/*.ts"],
            "coverageExclude": [
              "projects/taskflow/src/app/**/*.spec.ts",
              "projects/taskflow/src/app/app.config*.ts",
              "projects/taskflow/src/app/app.routes*.ts"
            ],
            "coverageThresholds": {
              "statements": 90,
              "lines": 90,
              "functions": 85,
              "branches": 80
            }
          }
        }
      }
    }
  }
}
